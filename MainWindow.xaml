<Window x:Class="FileConvertor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileConvertor"
        xmlns:vm="clr-namespace:FileConvertor.ViewModels"
        xmlns:core="clr-namespace:FileConvertor.Core;assembly=FileConvertor.Core"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="640" Width="760"
        MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 通用按钮样式 -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 首页 DataTemplate -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,20">
                    <TextBlock Text="文件转换工具" FontSize="28" FontWeight="Light" Foreground="#222" Margin="0,0,0,6"/>
                    <TextBlock Text="选择一个功能开始使用" FontSize="14" Foreground="#888" Margin="0,0,0,20"/>

                    <!-- PDF 操作卡片 -->
                    <TextBlock Text="PDF 工具" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,8,0,10"/>
                    <ItemsControl ItemsSource="{Binding PdfOperations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="8" Margin="6" Padding="16"
                                        Cursor="Hand" MouseLeftButtonUp="Card_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F8FAFF"/>
                                                    <Setter Property="BorderBrush" Value="#2D7FF9"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Icon}" FontSize="28" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#222"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#888"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 图像转换卡片 -->
                    <TextBlock Text="图像转换" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,20,0,10"/>
                    <ItemsControl ItemsSource="{Binding ImageOperations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="8" Margin="6" Padding="16"
                                        Cursor="Hand" MouseLeftButtonUp="ImageConvert_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F8FAFF"/>
                                                    <Setter Property="BorderBrush" Value="#2D7FF9"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Icon}" FontSize="28" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#222"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#888"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- PDF 操作详情页 DataTemplate -->
        <DataTemplate DataType="{x:Type vm:OperationViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部导航栏 -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                    <Grid Margin="20,14,20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="← 返回" Command="{Binding BackCommand}"
                                Padding="12,4" FontSize="13"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Operation.Icon}" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Operation.Name}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="#222" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内容区 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,20,24,20">

                        <!-- 文件拖放区 -->
                        <Border x:Name="OpDropArea"
                                Background="White"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,16"
                                MinHeight="140"
                                AllowDrop="True"
                                Drop="OpDropArea_Drop"
                                DragEnter="OpDropArea_DragEnter"
                                DragLeave="OpDropArea_DragLeave"
                                MouseLeftButtonUp="OpDropArea_Click"
                                Cursor="Hand"
                                Padding="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center"/>
                                <TextBlock Text="拖放文件到此处，或点击选择文件"
                                           FontSize="14" Foreground="#555" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                                <TextBlock Text="{Binding FileSummaryText}"
                                           FontSize="12" Foreground="#888" HorizontalAlignment="Center"/>
                                <TextBlock Text="（支持的格式自动识别）" FontSize="11" Foreground="#AAA"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 文件列表 -->
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4"
                                Padding="10" Margin="0,0,0,16" Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Text="已选择文件" FontSize="12" FontWeight="SemiBold" Foreground="#666"/>
                                <Button Grid.Row="0" Grid.Column="1" Content="清空" Command="{Binding ClearFilesCommand}"
                                        Padding="8,2" FontSize="11"/>
                                <ListBox Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding InputFiles}"
                                         BorderThickness="0" Background="Transparent" Margin="0,6,0,0"
                                         MaxHeight="120" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#444"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Button Grid.Column="1" Content="✕" Padding="6,0"
                                                                    FontSize="10" Foreground="#AAA"
                                                                    Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="BorderThickness" Value="0"/>
                                                                        <Setter Property="Foreground" Value="#AAAAAA"/>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Foreground" Value="#CC3333"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- 参数区（动态生成） -->
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4"
                                Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="参数设置" FontSize="13" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ParameterItemViewModel}">
                                        <Grid Margin="0,6" Visibility="{Binding Visibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                                       FontSize="12" Foreground="#555"/>

                                            <!-- 文本输入 (Text / PageRange) -->
                                            <TextBox Grid.Column="1" Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Text">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="PageRange">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Password">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>

                                            <!-- 下拉选择 (Select) -->
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                                      SelectedItem="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Select">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>

                                            <!-- 滑块 (Slider) -->
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0" Value="{Binding IntValue, UpdateSourceTrigger=PropertyChanged}"
                                                        Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}"
                                                        IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center">
                                                    <Slider.Style>
                                                        <Style TargetType="Slider">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Slider">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Slider.Style>
                                                </Slider>
                                                <TextBlock Grid.Column="1" Text="{Binding IntValue}" Width="36"
                                                           FontSize="12" Foreground="#555" VerticalAlignment="Center"
                                                           Margin="6,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Slider">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <!-- 复选框 (Checkbox) -->
                                            <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue, UpdateSourceTrigger=PropertyChanged}">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Checkbox">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 底部操作栏 -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                        Padding="20,12,20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ProgressBar Value="{Binding Progress}" Height="4" Width="240"
                                         Foreground="#2D7FF9" BorderThickness="0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#888" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="开始处理"
                                Command="{Binding StartCommand}"
                                Padding="32,10"
                                FontSize="15"
                                Background="#2D7FF9"
                                Foreground="White"
                                BorderBrush="#2D7FF9">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#2D7FF9"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#2D7FF9"/>
                                    <Setter Property="Padding" Value="32,10"/>
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#1E6FE0"/>
                                                        <Setter TargetName="b" Property="BorderBrush" Value="#1E6FE0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding CurrentView}"/>
    </Grid>
</Window>
